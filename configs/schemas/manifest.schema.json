{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jupedsim-mall/schemas/manifest.schema.json",
  "title": "Experiment run manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "scenario_name", "seed", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_name": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "status": {"enum": ["planned", "running", "completed", "failed", "interrupted"]},
    "started_at": {"type": ["string", "null"]},
    "finished_at": {"type": ["string", "null"]},
    "returncode": {"type": ["integer", "null"]},
    "scenario_snapshot": {"type": "object"},
    "reproducibility": {"type": "object"},
    "artifacts": {"type": "object"},
    "failure": {"type": ["object", "null"]}
  }
}
