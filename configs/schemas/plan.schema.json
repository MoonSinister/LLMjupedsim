{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.jupedsim-mall/schemas/plan.schema.json",
  "title": "Saved agent plan collection",
  "type": "object",
  "required": ["schema_version", "agents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "metadata": {"type": "object"},
    "validation": {"type": "object"},
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id", "exit_idx"],
        "properties": {
          "agent_id": {"type": ["string", "integer"]},
          "exit_idx": {"type": "integer", "minimum": 0},
          "role": {"enum": ["commuter", "shopper", "staff", "visitor"]},
          "desired_speed_mps": {"type": "number", "minimum": 0.8, "maximum": 1.8},
          "regions": {"type": "array", "items": {"type": "string"}},
          "activities": {"type": "array", "items": {"type": "object"}},
          "fallback_reason": {"type": "string"}
        }
      }
    }
  }
}
